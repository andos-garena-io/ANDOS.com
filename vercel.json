{
  "version": 2,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/ANDO.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ]
}
